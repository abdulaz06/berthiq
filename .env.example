# BerthIQ environment — copy to `.env` (which is gitignored and per-machine).
#
#   cp .env.example .env      # macOS
#   copy .env.example .env    # Windows
#
# This file documents every variable. `.env` itself is never committed because
# each developer's local Postgres password differs.

# ---------------------------------------------------------------------------
# DATABASE_URL — the backend's connection string to a NATIVE local Postgres.
# Postgres runs as a background service on each machine (set up once via
# `just setup`); Docker is NOT required for daily dev.
#
# NOTE on the password, per machine:
#   * Windows (Abdul): the PostgreSQL installer creates a `postgres` superuser
#     WITH a password you chose during install — put that password below.
#   * macOS (Shravani, Homebrew `postgresql@15`): the default role is your Mac
#     username with NO password, so the URL usually omits the password entirely,
#     e.g. postgresql+psycopg2://<your-mac-username>@localhost:5432/berthiq
#
# Create the database once:  createdb berthiq
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/berthiq

# ---------------------------------------------------------------------------
# Frontend (Next.js) public variables. Non-secret dev defaults are committed in
# frontend/.env.development, so you normally do NOT need to set these. Override
# here (or in frontend/.env.local) only if you change ports or want fixtures.
#
#   NEXT_PUBLIC_USE_FIXTURES  — "true" renders committed fixtures instead of
#                               calling the live backend (the contracts seam).
#   NEXT_PUBLIC_API_BASE_URL  — where the frontend reaches the backend.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_USE_FIXTURES=false
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
