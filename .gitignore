# ---- Secrets & per-machine config (never commit) ----
.env
.env.local
.env.*.local
aisstream_key.txt

# ---- Raw / collected data (never commit) ----
ais_data/
backend/data/datasets/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
backend/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
backend/openapi.json

# ---- Model artifacts (trained offline, can be large) ----
*.joblib
# ...except the committed miss-risk model: it's small and deterministic (seed
# 20260601), so a committed copy and a fresh `just train` agree, and CI/serving
# just load it (M1-07). Regenerate with `just train`.
!backend/models/risk_model.joblib

# ---- Node / Next.js ----
node_modules/
frontend/.next/
frontend/public/vendor/
.next/
*.tsbuildinfo

# ---- Test / build output ----
coverage/
frontend/coverage/
playwright-report/
test-results/

# ---- Editor / OS cruft ----
.DS_Store
.idea/
.vscode/
