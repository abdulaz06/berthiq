# Build separately with production NEXT_PUBLIC_* variables before enabling.
[Unit]
Description=BerthIQ Next.js frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=berthiq
WorkingDirectory=/srv/berthiq/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Next's image optimizer writes its cache; keep only this runtime path writable.
ReadWritePaths=/srv/berthiq/frontend/.next/cache
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
