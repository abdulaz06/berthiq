# Copy to deploy/.env.prod on the server (gitignored) and fill in real values.
# Generate the password with: openssl rand -hex 24

POSTGRES_PASSWORD=CHANGE_ME
# Internal compose network only; no sslmode needed. Keep the password in sync.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@postgres:5432/berthiq

# The Vercel origin, exactly (scheme + host, no trailing slash), as a JSON list.
CORS_ORIGINS=["https://berthiq.vercel.app"]

ENABLE_UPLOADS=false
JOB_TIMEOUT_SECONDS=90

# Public hostname for the API; its DNS A record must point at this VM.
API_DOMAIN=api.example.com
